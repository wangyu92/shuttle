# Copy to .env and edit.
# The address devices use to reach the server (also printed in setup and enrollment links).
SHUTTLE_PUBLIC_URL=https://sync.example.com
# Only for `--profile https`: the domain Caddy requests a certificate for (no https://).
SHUTTLE_DOMAIN=sync.example.com
# Optional
# SHUTTLE_VERSION=0.2.0
# SHUTTLE_LOCAL_PORT=8787
# TZ=Asia/Seoul
